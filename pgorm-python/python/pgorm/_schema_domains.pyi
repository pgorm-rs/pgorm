from collections.abc import Sequence
from typing import Any, Never
from ._expressions import Expr
from ._schema import DDL, Behavior, ColumnType, Name, TypeRef

class CreateDomain(DDL):
    def __init__(self, name: TypeRef, base: ColumnType) -> None: ...
    def collate(self, /, name: Name, *, schema: Name | None = ...) -> CreateDomain: ...
    def default(self, /, value: Any) -> CreateDomain: ...
    def not_null(self, /) -> CreateDomain: ...
    def null(self, /) -> CreateDomain: ...
    def check(self, /, condition: Expr, *, name: Name | None = ...) -> CreateDomain: ...

class PendingAlterDomain:
    def __init__(self, _native_only: Never, /) -> None: ...
    def set_default(self, /, value: Any) -> DDL: ...
    def drop_default(self, /) -> DDL: ...
    def set_not_null(self, /) -> DDL: ...
    def drop_not_null(self, /) -> DDL: ...
    def add_check(self, /, condition: Expr, *, name: Name | None = ..., not_valid: bool = ...) -> DDL: ...
    def drop_constraint(self, /, name: Name, *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
    def rename_constraint(self, /, name: Name, new_name: Name) -> DDL: ...
    def validate_constraint(self, /, name: Name) -> DDL: ...
    def rename_to(self, /, name: Name) -> DDL: ...

def alter_domain(name: TypeRef) -> PendingAlterDomain: ...
def drop_domain(names: TypeRef | Sequence[TypeRef], *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
