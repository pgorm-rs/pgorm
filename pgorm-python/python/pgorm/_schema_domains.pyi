from typing import Any
from ._native import TypeName, Compiled
from ._ranges import CreatedRange, CreatedMultirange
from ._expressions import Expr
from ._schema import DDL, BuiltinType, DataType, Name

class CreateDomain:
    def __init__(self, name: Name | TypeName, base: DataType | BuiltinType | TypeName | CreatedRange | CreatedMultirange) -> None: ...
    def collate(self, /, name: Name, *, schema: Name | None = ...) -> CreateDomain: ...
    def default(self, /, value: Any) -> CreateDomain: ...
    def not_null(self, /) -> CreateDomain: ...
    def null(self, /) -> CreateDomain: ...
    def check(self, /, condition: Expr, *, name: Name | None = ...) -> CreateDomain: ...
    def inspect(self, /) -> Compiled: ...

def set_domain_default(domain: Name | TypeName, value: Any) -> DDL: ...
def drop_domain_default(domain: Name | TypeName) -> DDL: ...
def set_domain_not_null(domain: Name | TypeName) -> DDL: ...
def drop_domain_not_null(domain: Name | TypeName) -> DDL: ...
def add_domain_check(domain: Name | TypeName, condition: Expr, *, name: Name | None = ..., not_valid: bool = ...) -> DDL: ...
def drop_domain_constraint(domain: Name | TypeName, name: Name, *, if_exists: bool = ..., cascade: bool = ...) -> DDL: ...
def rename_domain_constraint(domain: Name | TypeName, name: Name, new_name: Name) -> DDL: ...
def validate_domain_constraint(domain: Name | TypeName, name: Name) -> DDL: ...
def rename_domain(domain: Name | TypeName, new_name: Name) -> DDL: ...
def drop_domain(domain: Name | TypeName, *domains: Name | TypeName, if_exists: bool = ..., cascade: bool = ...) -> DDL: ...
