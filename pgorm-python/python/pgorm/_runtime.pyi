from collections.abc import Awaitable
from typing import Any, Literal, Never, overload

from ._listen import _Listener
from ._results import Record

STATEMENT_CACHE_CHANNEL: str

class _Pool:
    def __init__(self, dsn: str, *, tls: str | None = ..., ca_pem: bytes | None = ...,
                 max_size: int = ..., connect_timeout: float = ...,
                 acquire_timeout: float = ..., statement_cache_size: int = ...,
                 recycle: str = ..., statement_cache_channel: str | None = ...) -> None: ...
    def acquire(self, /) -> Awaitable[_Connection]: ...
    def close(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...
    def status(self, /) -> tuple[int, int, int, int]: ...
    def clear_statement_caches(self, /) -> None: ...
    def listener(self, /, capacity: int = ...) -> Awaitable[_Listener]: ...

class _Connection:
    def __init__(self, _native_only: Never, /) -> None: ...
    def begin(self, /, *, mode: str = ..., isolation: str | None = ...) -> Awaitable[_Transaction]: ...
    def ping(self, /) -> Awaitable[bool]: ...
    def close(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...
    def execute(self, /, query: Any) -> Awaitable[int]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["all"]) -> Awaitable[list[Record]]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["one"]) -> Awaitable[Record]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["optional"]) -> Awaitable[Record | None]: ...
    def stream(self, /, query: Any) -> Awaitable[_Stream]: ...
    def notify(self, /, channel: str, payload: str) -> Awaitable[None]: ...

class _Stream:
    def __init__(self, _native_only: Never, /) -> None: ...
    def next(self, /) -> Awaitable[Record | None]: ...
    def close(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...

class _Transaction:
    def __init__(self, _native_only: Never, /) -> None: ...
    def begin(self, /) -> Awaitable[_Transaction]: ...
    def finish(self, /, commit: bool) -> Awaitable[None]: ...
    def wait_closed(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...
    def owner_matches(self, /, parent: object) -> bool: ...
    def abort(self, /) -> Awaitable[None]: ...
    def execute(self, /, query: Any) -> Awaitable[int]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["all"]) -> Awaitable[list[Record]]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["one"]) -> Awaitable[Record]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["optional"]) -> Awaitable[Record | None]: ...
    def notify(self, /, channel: str, payload: str) -> Awaitable[None]: ...
