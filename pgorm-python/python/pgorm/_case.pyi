from typing import Any, Never
from ._conditions import Condition
from ._expressions import Expr

class SearchedCase(Expr):
    def __init__(self, _native_only: Never, /) -> None: ...
    def when(self, /, condition: Expr | Condition, result: Any) -> SearchedCase: ...
    def else_(self, /, result: Any) -> Expr: ...

class SimpleCase(Expr):
    def __init__(self, _native_only: Never, /) -> None: ...
    def when(self, /, value: Any, result: Any) -> SimpleCase: ...
    def else_(self, /, result: Any) -> Expr: ...

class CaseOperand:
    def __init__(self, _native_only: Never, /) -> None: ...
    def when(self, /, value: Any, result: Any) -> SimpleCase: ...

def case_when(condition: Expr | Condition, result: Any) -> SearchedCase: ...
def case_of(operand: Any) -> CaseOperand: ...
