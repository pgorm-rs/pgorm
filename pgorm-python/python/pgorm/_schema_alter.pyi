from collections.abc import Sequence
from typing import Literal, Never
from ._expressions import Expr
from ._schema import (
    DDL, Behavior, ColumnDef, Deferrability, Enforcement, KeyColumns, Name, ReferentialAction,
    TableRef,
)

Change = Literal["inherit", "no_inherit", "enforced", "not_enforced"]

class PendingAlterTable:
    def __init__(self, _native_only: Never, /) -> None: ...
    def add_column(self, /, column: ColumnDef, *, if_not_exists: bool = ...) -> AlterTable: ...
    def modify_column(self, /, column: ColumnDef) -> AlterTable: ...
    def drop_column(self, /, name: Name) -> AlterTable: ...
    def add_primary_key(self, /, columns: KeyColumns, *, name: Name | None = ..., include: Sequence[Name] | None = ..., deferrability: Deferrability | None = ..., without_overlaps: Name | None = ...) -> AlterTable: ...
    def add_unique(self, /, columns: KeyColumns, *, name: Name | None = ..., include: Sequence[Name] | None = ..., deferrability: Deferrability | None = ..., without_overlaps: Name | None = ..., nulls_not_distinct: bool = ...) -> AlterTable: ...
    def add_foreign_key(self, /, columns: KeyColumns, references: TableRef, ref_columns: KeyColumns, *, name: Name | None = ..., on_delete: ReferentialAction | None = ..., on_update: ReferentialAction | None = ..., deferrability: Deferrability | None = ..., enforcement: Enforcement | None = ..., period: tuple[Name, Name] | None = ..., not_valid: bool = ...) -> AlterTable: ...
    def add_check(self, /, condition: Expr, *, name: Name | None = ..., enforcement: Enforcement | None = ..., no_inherit: bool = ..., not_valid: bool = ...) -> AlterTable: ...
    def add_not_null(self, /, column: Name, *, name: Name | None = ..., no_inherit: bool = ..., not_valid: bool = ...) -> AlterTable: ...
    def drop_constraint(self, /, name: Name, *, if_exists: bool = ..., behavior: Behavior | None = ...) -> AlterTable: ...
    def validate_constraint(self, /, name: Name) -> AlterTable: ...
    def alter_constraint(self, /, name: Name, change: Change) -> AlterTable: ...
    def set_expression(self, /, column: Name, expression: Expr) -> AlterTable: ...
    def drop_expression(self, /, column: Name, *, if_exists: bool = ...) -> AlterTable: ...

class AlterTable(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def add_column(self, /, column: ColumnDef, *, if_not_exists: bool = ...) -> AlterTable: ...
    def modify_column(self, /, column: ColumnDef) -> AlterTable: ...
    def drop_column(self, /, name: Name) -> AlterTable: ...
    def add_primary_key(self, /, columns: KeyColumns, *, name: Name | None = ..., include: Sequence[Name] | None = ..., deferrability: Deferrability | None = ..., without_overlaps: Name | None = ...) -> AlterTable: ...
    def add_unique(self, /, columns: KeyColumns, *, name: Name | None = ..., include: Sequence[Name] | None = ..., deferrability: Deferrability | None = ..., without_overlaps: Name | None = ..., nulls_not_distinct: bool = ...) -> AlterTable: ...
    def add_foreign_key(self, /, columns: KeyColumns, references: TableRef, ref_columns: KeyColumns, *, name: Name | None = ..., on_delete: ReferentialAction | None = ..., on_update: ReferentialAction | None = ..., deferrability: Deferrability | None = ..., enforcement: Enforcement | None = ..., period: tuple[Name, Name] | None = ..., not_valid: bool = ...) -> AlterTable: ...
    def add_check(self, /, condition: Expr, *, name: Name | None = ..., enforcement: Enforcement | None = ..., no_inherit: bool = ..., not_valid: bool = ...) -> AlterTable: ...
    def add_not_null(self, /, column: Name, *, name: Name | None = ..., no_inherit: bool = ..., not_valid: bool = ...) -> AlterTable: ...
    def drop_constraint(self, /, name: Name, *, if_exists: bool = ..., behavior: Behavior | None = ...) -> AlterTable: ...
    def validate_constraint(self, /, name: Name) -> AlterTable: ...
    def alter_constraint(self, /, name: Name, change: Change) -> AlterTable: ...
    def set_expression(self, /, column: Name, expression: Expr) -> AlterTable: ...
    def drop_expression(self, /, column: Name, *, if_exists: bool = ...) -> AlterTable: ...

def alter_table(table: TableRef) -> PendingAlterTable: ...
