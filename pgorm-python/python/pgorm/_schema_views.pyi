from collections.abc import Sequence
from typing import Literal, Never
from ._schema import DDL, Behavior, Name, TableRef
from ._statements import Select

class CreateView(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def or_replace(self, /) -> CreateView: ...
    def columns(self, /, names: Sequence[Name]) -> CreateView: ...
    def check_option(self, /, option: Literal["local", "cascaded"]) -> CreateView: ...
    def security_barrier(self, /) -> CreateView: ...
    def security_invoker(self, /) -> CreateView: ...

class CreateRecursiveView(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def or_replace(self, /) -> CreateRecursiveView: ...
    def columns(self, /, names: Sequence[Name]) -> CreateRecursiveView: ...
    def security_barrier(self, /) -> CreateRecursiveView: ...
    def security_invoker(self, /) -> CreateRecursiveView: ...

class CreateMaterializedView(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def if_not_exists(self, /) -> CreateMaterializedView: ...
    def columns(self, /, names: Sequence[Name]) -> CreateMaterializedView: ...
    def with_no_data(self, /) -> CreateMaterializedView: ...

class CreateTableAs(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def if_not_exists(self, /) -> CreateTableAs: ...
    def columns(self, /, names: Sequence[Name]) -> CreateTableAs: ...
    def with_no_data(self, /) -> CreateTableAs: ...

def create_view(name: TableRef, query: Select) -> CreateView: ...
def create_recursive_view(name: TableRef, columns: Name | Sequence[Name], query: Select) -> CreateRecursiveView: ...
def create_materialized_view(name: TableRef, query: Select) -> CreateMaterializedView: ...
def create_table_as(name: TableRef, query: Select) -> CreateTableAs: ...
def drop_view(names: TableRef | Sequence[TableRef], *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
def refresh_materialized_view(name: TableRef, *, concurrently: bool = ..., with_no_data: bool = ...) -> DDL: ...
def drop_materialized_view(names: TableRef | Sequence[TableRef], *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
