from typing import final

@final
class Interval:
    def __init__(self, months: int = ..., days: int = ..., microseconds: int = ...) -> None: ...
    @property
    def months(self) -> int: ...
    @property
    def days(self) -> int: ...
    @property
    def microseconds(self) -> int: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __hash__(self, /) -> int: ...
