from collections.abc import Sequence
from typing import Never
from ._schema import DDL, Behavior, Collation, ColumnType, Name, TypeRef

class CreateType(DDL):
    def __init__(self, name: TypeRef) -> None: ...
    def as_enum(self, /) -> CreateType: ...
    def values(self, /, labels: Sequence[str]) -> CreateType: ...
    def as_composite(self, /) -> CreateType: ...
    def attribute(self, /, name: Name, kind: ColumnType, *, collation: Collation | None = ...) -> CreateType: ...
    def as_range(self, /, subtype: ColumnType, *, collation: Collation | None = ..., subtype_opclass: Name | None = ..., subtype_diff: Name | None = ..., multirange_type_name: TypeRef | None = ...) -> CreateType: ...

class PendingAlterType:
    def __init__(self, _native_only: Never, /) -> None: ...
    def add_value(self, /, label: str, *, before: str | None = ..., after: str | None = ...) -> DDL: ...
    def rename_to(self, /, name: Name) -> DDL: ...
    def rename_value(self, /, label: str, new_label: str) -> DDL: ...
    def rename_attribute(self, /, name: Name, new_name: Name) -> RenameAttribute: ...
    def add_attribute(self, /, name: Name, kind: ColumnType, *, collation: Collation | None = ...) -> AlterComposite: ...
    def drop_attribute(self, /, name: Name, *, if_exists: bool = ...) -> AlterComposite: ...
    def alter_attribute(self, /, name: Name, kind: ColumnType, *, collation: Collation | None = ...) -> AlterComposite: ...

class AlterComposite(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def add_attribute(self, /, name: Name, kind: ColumnType, *, collation: Collation | None = ...) -> AlterComposite: ...
    def drop_attribute(self, /, name: Name, *, if_exists: bool = ...) -> AlterComposite: ...
    def alter_attribute(self, /, name: Name, kind: ColumnType, *, collation: Collation | None = ...) -> AlterComposite: ...
    def behavior(self, /, behavior: Behavior) -> AlterComposite: ...

class RenameAttribute(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def behavior(self, /, behavior: Behavior) -> RenameAttribute: ...

def alter_type(name: TypeRef) -> PendingAlterType: ...
def drop_type(names: TypeRef | Sequence[TypeRef], *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
