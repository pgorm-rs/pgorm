from collections.abc import Sequence
from typing import Literal, Never, Unpack
from ._schema import DDL, Behavior, Name, SequenceOptions, TableRef

SequenceType = Literal["smallint", "integer", "bigint"]

class CreateSequence(DDL):
    def __init__(self, name: TableRef) -> None: ...
    def if_not_exists(self, /) -> CreateSequence: ...
    def as_type(self, /, kind: SequenceType) -> CreateSequence: ...
    def options(self, /, **options: Unpack[SequenceOptions]) -> CreateSequence: ...
    def owned_by(self, /, table: TableRef | None, column: Name | None = ...) -> CreateSequence: ...

class PendingAlterSequence:
    def __init__(self, _native_only: Never, /) -> None: ...
    def as_type(self, /, kind: SequenceType) -> AlterSequence: ...
    def options(self, /, **options: Unpack[SequenceOptions]) -> AlterSequence: ...
    def owned_by(self, /, table: TableRef | None, column: Name | None = ...) -> AlterSequence: ...
    def restart(self, /, value: int | None = ...) -> AlterSequence: ...

class AlterSequence(DDL):
    def __init__(self, _native_only: Never, /) -> None: ...
    def if_exists(self, /) -> AlterSequence: ...
    def as_type(self, /, kind: SequenceType) -> AlterSequence: ...
    def options(self, /, **options: Unpack[SequenceOptions]) -> AlterSequence: ...
    def owned_by(self, /, table: TableRef | None, column: Name | None = ...) -> AlterSequence: ...
    def restart(self, /, value: int | None = ...) -> AlterSequence: ...

def alter_sequence(name: TableRef) -> PendingAlterSequence: ...
def drop_sequence(names: TableRef | Sequence[TableRef], *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
def rename_sequence(name: TableRef, new_name: Name) -> DDL: ...
def create_extension(name: Name, *, if_not_exists: bool = ..., schema: Name | None = ..., version: str | None = ..., cascade: bool = ...) -> DDL: ...
def drop_extension(name: Name, *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
