from typing import ClassVar, Never
from ._expressions import Expr, Condition
from ._query_types import Aliased, Compiled, Identifier, OrderBy
from ._merge import With
from ._windows import ExtendedWindow, Window, Windowed
from ._native import TypeName
from ._ranges import CreatedRange, CreatedMultirange
from ._schema import BuiltinType, DataType

class Table:
    def __init__(self, name: str | Identifier, *, schema: str | Identifier | None = ...,
                 alias: str | Identifier | None = ...) -> None: ...
    def as_(self, /, alias: str | Identifier) -> Table: ...
    def col(self, /, name: str | Identifier) -> Expr: ...
    def star(self, /) -> Expr: ...
    def tablesample(self, /, method: SampleMethod, percentage: int | float, *,
                    repeatable: int | float | None = ...) -> FromItem: ...
    @property
    def name(self) -> str: ...
    @property
    def schema(self) -> str | None: ...
    @property
    def alias(self) -> str | None: ...

class FromItem:
    def __init__(self, _native_only: Never, /) -> None: ...
    def col(self, /, name: str | Identifier) -> Expr: ...
    def star(self, /) -> Expr: ...
    @property
    def alias(self) -> str: ...

class SampleMethod:
    def __init__(self, _native_only: Never, /) -> None: ...
    Bernoulli: ClassVar[SampleMethod]
    System: ClassVar[SampleMethod]

class TableFunction:
    def __init__(self, call: Expr) -> None: ...
    @staticmethod
    def rows_from(call: Expr) -> TableFunction: ...
    def and_(self, /, call: Expr) -> TableFunction: ...
    def with_ordinality(self, /) -> TableFunction: ...
    def columns(self, /, *names: str | Identifier) -> TableFunction: ...
    def column_definition(
        self, /, name: str | Identifier, data_type: DataType | BuiltinType | TypeName | CreatedRange | CreatedMultirange
    ) -> TableFunction: ...
    def alias(self, /, name: str | Identifier) -> FromItem: ...

class GroupingElement:
    def __init__(self, _native_only: Never, /) -> None: ...
    @staticmethod
    def set(*exprs: Expr) -> GroupingElement: ...
    @staticmethod
    def empty() -> GroupingElement: ...
    @staticmethod
    def rollup(*exprs: Expr) -> GroupingElement: ...
    @staticmethod
    def cube(*exprs: Expr) -> GroupingElement: ...
    @staticmethod
    def sets(first: Expr | GroupingElement, *rest: Expr | GroupingElement) -> GroupingElement: ...

class Join:
    def __init__(self, _native_only: Never, /) -> None: ...
    Inner: ClassVar[Join]
    Left: ClassVar[Join]
    Right: ClassVar[Join]
    Full: ClassVar[Join]

class Select:
    def __init__(self, *items: Expr | Aliased | Windowed) -> None: ...
    def select(self, /, *items: Expr | Aliased | Windowed) -> Select: ...
    def from_(self, /, item: Table | FromItem) -> Select: ...
    def where(self, /, predicate: Expr | Condition) -> Select: ...
    def join(self, /, item: Table | FromItem, on: Expr | Condition, *, kind: Join = ...) -> Select: ...
    def cross_join(self, /, item: Table | FromItem) -> Select: ...
    def group_by(self, /, *items: Expr | GroupingElement) -> Select: ...
    def group_by_distinct(self, /) -> Select: ...
    def having(self, /, predicate: Expr | Condition) -> Select: ...
    def order_by(self, /, *orderings: OrderBy) -> Select: ...
    def limit(self, /, value: int | None) -> Select: ...
    def limit_with_ties(self, /, count: int) -> Select: ...
    def offset(self, /, value: int | None) -> Select: ...
    def distinct(self, /) -> Select: ...
    def window(self, /, name: str | Identifier, window: Window | ExtendedWindow) -> Select: ...
    def with_(self, /, clause: With) -> Select: ...
    def union(self, /, other: Select) -> Select: ...
    def union_all(self, /, other: Select) -> Select: ...
    def intersect(self, /, other: Select) -> Select: ...
    def intersect_all(self, /, other: Select) -> Select: ...
    def except_(self, /, other: Select) -> Select: ...
    def except_all(self, /, other: Select) -> Select: ...
    def inspect(self, /) -> Compiled: ...
