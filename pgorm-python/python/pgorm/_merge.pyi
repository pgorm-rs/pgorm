from typing import Any, ClassVar, Generic, Literal, Never, TypeAlias, TypeVar
from ._expressions import Expr, Condition
from ._query_types import Aliased, Compiled, Identifier
from ._statements import Select
from ._from_items import FromItem, Table
from ._writes import Delete, Insert, Update

# The kinds of row an action takes, a type the checker alone sees: an action
# taking both, as doing nothing does, stands wherever one taking either does.
_Row = TypeVar("_Row", contravariant=True)

class MergeAction(Generic[_Row]):
    def __init__(self, _native_only: Never, /) -> None: ...
    @staticmethod
    def update(column: str | Identifier, value: Any) -> MergeUpdate: ...
    @staticmethod
    def insert(column: str | Identifier, value: Any) -> MergeInsert: ...
    @staticmethod
    def delete() -> MergeAction[Literal["target"]]: ...
    @staticmethod
    def do_nothing() -> MergeAction[Literal["target", "source"]]: ...
    @staticmethod
    def insert_defaults() -> MergeAction[Literal["source"]]: ...

class Overriding:
    def __init__(self, _native_only: Never, /) -> None: ...
    SystemValue: ClassVar[Overriding]
    UserValue: ClassVar[Overriding]

class MergeUpdate:
    def __init__(self, _native_only: Never, /) -> None: ...
    def set(self, /, column: str | Identifier, value: Any) -> MergeUpdate: ...

class MergeInsert:
    def __init__(self, _native_only: Never, /) -> None: ...
    def set(self, /, column: str | Identifier, value: Any) -> MergeInsert: ...
    def overriding(self, /, overriding: Overriding) -> MergeInsert: ...

_TargetRowAction: TypeAlias = MergeUpdate | MergeAction[Literal["target"]]
_SourceRowAction: TypeAlias = MergeInsert | MergeAction[Literal["source"]]

class PendingMerge:
    def __init__(self, _native_only: Never, /) -> None: ...
    def when_matched(self, /, action: _TargetRowAction, *,
                     condition: Expr | Condition | None = ...) -> Merge: ...
    def when_not_matched(self, /, action: _SourceRowAction, *,
                         condition: Expr | Condition | None = ...) -> Merge: ...
    def when_not_matched_by_source(self, /, action: _TargetRowAction, *,
                                   condition: Expr | Condition | None = ...) -> Merge: ...

class Merge:
    def __init__(self, _native_only: Never, /) -> None: ...
    def when_matched(self, /, action: _TargetRowAction, *,
                     condition: Expr | Condition | None = ...) -> Merge: ...
    def when_not_matched(self, /, action: _SourceRowAction, *,
                         condition: Expr | Condition | None = ...) -> Merge: ...
    def when_not_matched_by_source(self, /, action: _TargetRowAction, *,
                                   condition: Expr | Condition | None = ...) -> Merge: ...
    def returning(self, /, *items: Expr | Aliased, old_as: str | Identifier | None = ...,
                  new_as: str | Identifier | None = ...) -> Merge: ...
    def returning_action(self, /) -> Merge: ...
    def with_(self, /, clause: With) -> Merge: ...
    def only(self, /) -> Merge: ...
    def inspect(self, /) -> Compiled: ...

_Columns = list[str | Identifier] | tuple[str | Identifier, ...]

class With:
    def __init__(self, name: str | Identifier, query: Select | Insert | Update | Delete | Merge, *,
                 columns: _Columns | None = ..., materialized: bool | None = ...) -> None: ...
    def cte(self, /, name: str | Identifier, query: Select | Insert | Update | Delete | Merge, *,
            columns: _Columns | None = ..., materialized: bool | None = ...) -> With: ...
    @staticmethod
    def recursive(name: str | Identifier, query: Select, *, columns: _Columns | None = ...,
                  materialized: bool | None = ..., search: Search | None = ...,
                  cycle: Cycle | None = ...) -> With: ...

class SearchOrder:
    def __init__(self, _native_only: Never, /) -> None: ...
    Breadth: ClassVar[SearchOrder]
    Depth: ClassVar[SearchOrder]

class Search:
    def __init__(self, order: SearchOrder, by: Expr, set: str | Identifier) -> None: ...

class Cycle:
    def __init__(self, by: Expr, set: str | Identifier, using: str | Identifier) -> None: ...

class ReturningRow:
    def __init__(self, _native_only: Never, /) -> None: ...
    Old: ClassVar[ReturningRow]
    New: ClassVar[ReturningRow]
    def col(self, /, name: str | Identifier) -> Expr: ...
    def star(self, /) -> Expr: ...

def merge(target: Table, source: Table | FromItem, on: Expr | Condition) -> PendingMerge: ...
