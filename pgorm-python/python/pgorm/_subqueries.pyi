from typing import Any, Never
from ._expressions import Expr
from ._statements import Select

def array(select: Select) -> Expr: ...
def exists(select: Select) -> Expr: ...
def scalar(select: Select) -> Expr: ...

class Quantified:
    def __init__(self, _native_only: Never, /) -> None: ...
    def __bool__(self, /) -> bool: ...

def any_(source: Select | Expr | Any) -> Quantified: ...
def all_(source: Select | Expr | Any) -> Quantified: ...
