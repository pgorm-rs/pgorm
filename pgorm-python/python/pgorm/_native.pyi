from typing import Any
from collections.abc import Awaitable
from asyncio import CancelledError as CancelledError

__version__: str
__pgorm_version__: str

class PgOrmError(Exception): ...
class UnsupportedCapabilityError(PgOrmError): ...
class ConstructionError(PgOrmError): ...
class ConnectionError(PgOrmError): ...
class DatabaseError(PgOrmError):
    sqlstate: str
    message: str
    severity: str
    detail: str | None
    hint: str | None
    schema: str | None
    table: str | None
    column: str | None
    constraint: str | None
class DecodeError(PgOrmError): ...
class TimeoutError(PgOrmError): ...
class LifecycleError(PgOrmError): ...
class InternalError(PgOrmError): ...

class _Pool:
    def __init__(self, dsn: str, *, tls: str | None = ..., ca_pem: bytes | None = ...,
                 max_size: int = ..., connect_timeout: float = ...,
                 acquire_timeout: float = ..., statement_cache_size: int = ...,
                 recycle: str = ...) -> None: ...
    def acquire(self) -> Awaitable[_Connection]: ...
    def close(self) -> Awaitable[None]: ...
    def closed(self) -> bool: ...
    def status(self) -> tuple[int, int, int, int]: ...

class _Connection:
    def ping(self) -> Awaitable[bool]: ...
    def close(self) -> Awaitable[None]: ...
    def closed(self) -> bool: ...
    def execute(self, query: Any) -> Awaitable[int]: ...
    def fetch(self, query: Any, mode: str) -> Awaitable[Any]: ...
    def stream(self, query: Any) -> Awaitable[_Stream]: ...

class _Stream:
    def next(self) -> Awaitable[Record | None]: ...
    def close(self) -> Awaitable[None]: ...
    def closed(self) -> bool: ...

def capabilities() -> dict[str, Any]: ...
def require_capability(operation: str) -> None: ...

class TypeName:
    def __init__(self, name: str, *, schema: str | None = ...) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def schema(self) -> str | None: ...

class Value:
    def __init__(self, value: Any, kind: str | TypeName | None = ...) -> None: ...
    @staticmethod
    def null(kind: str | TypeName) -> Value: ...
    @staticmethod
    def json(value: Any) -> Value: ...
    @staticmethod
    def array(kind: str | TypeName, values: list[Any] | tuple[Any, ...] | None) -> Value: ...
    @property
    def kind(self) -> str: ...
    @property
    def is_null(self) -> bool: ...
    @property
    def value(self) -> Any: ...
    @property
    def type_name(self) -> TypeName | None: ...
    @property
    def element_type(self) -> str | TypeName | None: ...
    def items(self) -> list[Value] | None: ...
    def snapshot(self) -> dict[str, Any]: ...

