from .transactions import Transaction
from collections.abc import Awaitable
from typing import Any, Literal, TypeAlias, Never
from ._native import Compiled, EntityModel
from .runtime import Connection, Pool

SourceRow: TypeAlias = tuple[EntityModel | None, ...]

class SourceSelection:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def name(self) -> str: ...
    def describe(self, /) -> dict[str, Any]: ...

class SelectedSources:
    def __init__(self, _native_only: Never, /) -> None: ...
    def inspect(
        self, /, *, terminal: Literal["all", "one", "optional"] = ...
    ) -> Compiled: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[SourceRow]]: ...
    def one(self, /, connection: Pool | Connection | Transaction) -> Awaitable[SourceRow]: ...
    def optional(self, /, connection: Pool | Connection | Transaction) -> Awaitable[SourceRow | None]: ...
