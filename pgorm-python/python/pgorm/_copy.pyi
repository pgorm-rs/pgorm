from collections.abc import Awaitable, Buffer
from typing import Any, Generic, Literal, Never, TypeVar
from ._expressions import Expr, Condition
from ._merge import Merge
from ._native import _Connection, _Transaction
from ._query_types import Compiled, Identifier
from ._statements import Select, Table
from ._writes import Delete, Insert, Update

_Format = TypeVar("_Format", Literal["text"], Literal["csv"], Literal["binary"])
# A statement in a delimited-text format, text or csv; binary has none of their options.
_DelimitedFrom = TypeVar("_DelimitedFrom", bound=CopyFrom[Literal["text"]] | CopyFrom[Literal["csv"]])
_DelimitedTo = TypeVar("_DelimitedTo", bound=CopyTo[Literal["text"]] | CopyTo[Literal["csv"]])

class CopyFrom(Generic[_Format]):
    def __init__(self, table: Table, format: _Format) -> None: ...
    @property
    def format(self) -> _Format: ...
    def columns(self, /, *columns: str | Identifier) -> CopyFrom[_Format]: ...
    def where_(self, /, predicate: Expr | Condition) -> CopyFrom[_Format]: ...
    def freeze(self, /) -> CopyFrom[_Format]: ...
    def delimiter(self: _DelimitedFrom, /, delimiter: str) -> _DelimitedFrom: ...
    def null_string(self: _DelimitedFrom, /, null: str) -> _DelimitedFrom: ...
    def default_string(self: _DelimitedFrom, /, default: str) -> _DelimitedFrom: ...
    def header(self: _DelimitedFrom, /) -> _DelimitedFrom: ...
    def header_match(self: _DelimitedFrom, /) -> _DelimitedFrom: ...
    def encoding(self: _DelimitedFrom, /, encoding: str) -> _DelimitedFrom: ...
    def on_error_ignore(self: _DelimitedFrom, /, reject_limit: int | None = ...,
                        log_verbosity: Literal["verbose", "silent"] | None = ...) -> _DelimitedFrom: ...
    def quote(self: CopyFrom[Literal["csv"]], /, quote: str) -> CopyFrom[Literal["csv"]]: ...
    def escape(self: CopyFrom[Literal["csv"]], /, escape: str) -> CopyFrom[Literal["csv"]]: ...
    def force_not_null(self: CopyFrom[Literal["csv"]], /, *columns: str | Identifier) -> CopyFrom[Literal["csv"]]: ...
    def force_not_null_all(self: CopyFrom[Literal["csv"]], /) -> CopyFrom[Literal["csv"]]: ...
    def force_null(self: CopyFrom[Literal["csv"]], /, *columns: str | Identifier) -> CopyFrom[Literal["csv"]]: ...
    def force_null_all(self: CopyFrom[Literal["csv"]], /) -> CopyFrom[Literal["csv"]]: ...
    def inspect(self, /) -> Compiled: ...

class CopyTo(Generic[_Format]):
    def __init__(self, source: Table | Select | Insert | Update | Delete | Merge, format: _Format) -> None: ...
    @property
    def format(self) -> _Format: ...
    def delimiter(self: _DelimitedTo, /, delimiter: str) -> _DelimitedTo: ...
    def null_string(self: _DelimitedTo, /, null: str) -> _DelimitedTo: ...
    def header(self: _DelimitedTo, /) -> _DelimitedTo: ...
    def encoding(self: _DelimitedTo, /, encoding: str) -> _DelimitedTo: ...
    def quote(self: CopyTo[Literal["csv"]], /, quote: str) -> CopyTo[Literal["csv"]]: ...
    def escape(self: CopyTo[Literal["csv"]], /, escape: str) -> CopyTo[Literal["csv"]]: ...
    def force_quote(self: CopyTo[Literal["csv"]], /, *columns: str | Identifier) -> CopyTo[Literal["csv"]]: ...
    def force_quote_all(self: CopyTo[Literal["csv"]], /) -> CopyTo[Literal["csv"]]: ...
    def inspect(self, /) -> Compiled: ...

class _CopyIn:
    def __init__(self, _native_only: Never, /) -> None: ...
    def write(self, /, data: Buffer) -> Awaitable[bool]: ...
    def finish(self, /) -> Awaitable[int]: ...
    def abort(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...

class _CopyOut:
    def __init__(self, _native_only: Never, /) -> None: ...
    def next(self, /) -> Awaitable[bytes | None]: ...
    def close(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...

def _copy_in(target: _Connection | _Transaction, statement: CopyFrom[Any]) -> Awaitable[_CopyIn]: ...
def _copy_out(target: _Connection | _Transaction, statement: CopyTo[Any]) -> Awaitable[_CopyOut]: ...
