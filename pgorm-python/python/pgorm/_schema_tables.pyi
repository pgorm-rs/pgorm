from collections.abc import Sequence
from typing import Literal
from ._expressions import Expr, Condition
from ._schema import (
    DDL, Behavior, ColumnDef, Deferrability, Enforcement, KeyColumns, Name, ReferentialAction,
    TableRef,
)

class CreateTable(DDL):
    def __init__(self, table: TableRef) -> None: ...
    def column(self, /, column: ColumnDef) -> CreateTable: ...
    def if_not_exists(self, /) -> CreateTable: ...
    def primary_key(self, /, columns: KeyColumns, *, name: Name | None = ..., include: Sequence[Name] | None = ..., deferrability: Deferrability | None = ..., without_overlaps: Name | None = ...) -> CreateTable: ...
    def unique(self, /, columns: KeyColumns, *, name: Name | None = ..., include: Sequence[Name] | None = ..., deferrability: Deferrability | None = ..., without_overlaps: Name | None = ..., nulls_not_distinct: bool = ...) -> CreateTable: ...
    def foreign_key(self, /, columns: KeyColumns, references: TableRef, ref_columns: KeyColumns, *, name: Name | None = ..., on_delete: ReferentialAction | None = ..., on_update: ReferentialAction | None = ..., deferrability: Deferrability | None = ..., enforcement: Enforcement | None = ..., period: tuple[Name, Name] | None = ...) -> CreateTable: ...
    def check(self, /, condition: Expr, *, name: Name | None = ..., enforcement: Enforcement | None = ..., no_inherit: bool = ...) -> CreateTable: ...

class CreateIndex(DDL):
    def __init__(self, table: TableRef, on: Name | Expr, *, name: Name | None = ..., order: Literal["asc", "desc"] | None = ..., operator_class: Name | None = ...) -> None: ...
    def column(self, /, on: Name | Expr, *, order: Literal["asc", "desc"] | None = ..., operator_class: Name | None = ...) -> CreateIndex: ...
    def unique(self, /) -> CreateIndex: ...
    def nulls_not_distinct(self, /) -> CreateIndex: ...
    def if_not_exists(self, /) -> CreateIndex: ...
    def using(self, /, method: Name) -> CreateIndex: ...
    def include(self, /, columns: Sequence[Name]) -> CreateIndex: ...
    def where(self, /, predicate: Expr | Condition) -> CreateIndex: ...

def drop_table(tables: TableRef | Sequence[TableRef], *, if_exists: bool = ..., behavior: Behavior | None = ...) -> DDL: ...
def rename_table(table: TableRef, name: Name) -> DDL: ...
def rename_column(table: TableRef, name: Name, new_name: Name) -> DDL: ...
def rename_constraint(table: TableRef, name: Name, new_name: Name) -> DDL: ...
def truncate_table(table: TableRef) -> DDL: ...
def comment_on_table(table: TableRef, text: str) -> DDL: ...
def comment_on_column(table: TableRef, column: Name, text: str) -> DDL: ...
def drop_index(table: TableRef, name: Name, *, if_exists: bool = ...) -> DDL: ...
