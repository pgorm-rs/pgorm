from typing import Any, Never
from ._expressions import Expr, Condition
from ._query_types import Aliased, Compiled, Identifier
from ._from_items import FromItem, Table
from ._statements import Select
from ._merge import Overriding, With

class Conflict:
    def __init__(self, _native_only: Never, /) -> None: ...
    @staticmethod
    def do_nothing() -> Conflict: ...
    @staticmethod
    def on_constraint(name: str | Identifier) -> ConflictTarget: ...

class ConflictTarget:
    def __init__(self, *targets: str | Identifier | Expr) -> None: ...
    def where(self, /, predicate: Expr | Condition) -> ConflictTarget: ...
    def do_nothing(self, /) -> Conflict: ...
    def update(self, /, *columns: str | Identifier) -> ConflictUpdate: ...
    def set(self, /, column: str | Identifier, value: Any) -> ConflictUpdate: ...

class ConflictUpdate:
    def __init__(self, _native_only: Never, /) -> None: ...
    def set(self, /, column: str | Identifier, value: Any) -> ConflictUpdate: ...
    def update(self, /, column: str | Identifier) -> ConflictUpdate: ...
    def where(self, /, predicate: Expr | Condition) -> ConflictUpdate: ...

class Insert:
    def __init__(self, table: Table) -> None: ...
    def columns(self, /, *columns: str | Identifier) -> Insert: ...
    def values(self, /, *values: Any) -> Insert: ...
    def select(self, /, query: Select) -> Insert: ...
    def default_values(self, /) -> Insert: ...
    def overriding(self, /, overriding: Overriding) -> Insert: ...
    def on_conflict(self, /, action: Conflict | ConflictUpdate) -> Insert: ...
    def returning(self, /, *items: Expr | Aliased, old_as: str | Identifier | None = ...,
                  new_as: str | Identifier | None = ...) -> Insert: ...
    def with_(self, /, clause: With) -> Insert: ...
    def inspect(self, /) -> Compiled: ...

class Update:
    def __init__(self, table: Table) -> None: ...
    def set(self, /, column: str | Identifier, value: Any) -> Update: ...
    def where(self, /, predicate: Expr | Condition) -> Update: ...
    def all_rows(self, /) -> Update: ...
    def from_(self, /, item: Table | FromItem) -> Update: ...
    def returning(self, /, *items: Expr | Aliased, old_as: str | Identifier | None = ...,
                  new_as: str | Identifier | None = ...) -> Update: ...
    def with_(self, /, clause: With) -> Update: ...
    def inspect(self, /) -> Compiled: ...

class Delete:
    def __init__(self, table: Table) -> None: ...
    def where(self, /, predicate: Expr | Condition) -> Delete: ...
    def all_rows(self, /) -> Delete: ...
    def using(self, /, item: Table | FromItem) -> Delete: ...
    def returning(self, /, *items: Expr | Aliased, old_as: str | Identifier | None = ...,
                  new_as: str | Identifier | None = ...) -> Delete: ...
    def with_(self, /, clause: With) -> Delete: ...
    def inspect(self, /) -> Compiled: ...

class RawSQL:
    def __init__(self, template: str, values: list[Any] | tuple[Any, ...] | None = ...) -> None: ...
    @property
    def template(self) -> str: ...
    def inspect(self, /) -> Compiled: ...
    def inline_sql(self, /) -> str: ...
