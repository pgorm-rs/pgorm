specs ({
    name pgorm,
    include (docs/spec/**/*.md),
    impls ({
        name main,
        languages (@rust @python),
        include (
            src/**/*.rs
            pgorm-macros/src/**/*.rs
            pgorm-codegen/src/**/*.rs
            pgorm-migration/src/**/*.rs
            pgorm-pool/src/**/*.rs
            pgorm-query/src/**/*.rs
            pgorm-query/pgorm-query-attr/src/**/*.rs
            pgorm-query/pgorm-query-derive/src/**/*.rs
            pgorm-sql-macro/src/**/*.rs
            security/sqlmap/adapter/src/**/*.rs
            security/sqlmap/harness.py
            security/sqlmap/check.py
            pgorm-python/src/**/*.rs
            pgorm-python/python/**/*.py
            security/generative/src/**/*.py
            security/generative/bridge/src/**/*.rs
        ),
        test_include (
            tests/**/*.rs
            pgorm-macros/tests/**/*.rs
            pgorm-codegen/tests/**/*.rs
            pgorm-migration/tests/**/*.rs
            pgorm-pool/tests/**/*.rs
            pgorm-query/tests/**/*.rs
            pgorm-query/pgorm-query-attr/tests/**/*.rs
            pgorm-query/pgorm-query-derive/tests/**/*.rs
            pgorm-sql-macro/tests/**/*.rs
            security/sqlmap/test_*.py
            security/sqlmap/adapter/tests/**/*.rs
            pgorm-python/tests/**/*.rs
            pgorm-python/tests/**/*.py
            security/generative/tests/**/*.py
            security/generative/bridge/tests/**/*.rs
        ),
        exclude (
            target/**
        )
    })
})
