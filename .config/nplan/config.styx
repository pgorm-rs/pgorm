platforms (
    {
        platform "python-application"
        files (pgorm-python/**/*.rs pgorm-python/Cargo.toml pgorm-python/Cargo.lock pgorm-python/tests/application-binding/Cargo.toml pgorm-python/tests/application-binding/Cargo.lock)
        checks {
            format {
                cmd "cargo fmt --manifest-path pgorm-python/tests/application-binding/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path pgorm-python/tests/application-binding/Cargo.toml --all"
            }
            clippy {
                cmd "cargo clippy --manifest-path pgorm-python/tests/application-binding/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "python-native"
        files (pgorm-python/**/*.rs pgorm-python/Cargo.toml pgorm-python/Cargo.lock)
        checks {
            format {
                cmd "cargo fmt --manifest-path pgorm-python/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path pgorm-python/Cargo.toml --all"
            }
            check {
                cmd "cargo check --manifest-path pgorm-python/Cargo.toml --locked --target-dir target"
            }
            clippy {
                cmd "cargo clippy --manifest-path pgorm-python/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "rust"
        files (src/**/*.rs pgorm-macros/**/*.rs pgorm-codegen/**/*.rs pgorm-migration/**/*.rs pgorm-pool/**/*.rs pgorm-query/**/*.rs pgorm-sql-macro/**/*.rs tests/**/*.rs)
        checks {
            format {
                cmd "cargo fmt --all -- --check"
                fix "cargo fmt --all"
            }
            check {
                cmd "cargo check --workspace"
            }
            // nextest stays out of the commit gate deliberately: it needs a
            // live Postgres and does not fit the check budget. Run it
            // explicitly.
            clippy {
                cmd "cargo clippy --workspace --all-targets -- -D warnings"
            }
        }
    }
)

commit {
    type-prefix "required"
}

// Workflow coverage lives in the sidecar; code keeps its inline annotations.
annotations {
    mode @both
}

quality {
    // scaffold templates are starting shapes for downstream
    // crates, not code any structural gate can judge
    exempt-paths (pgorm-migration/template/**)
    test-footprint {
        // roll the test:prod ratio up per crate so tests/
        // counts toward src/ — the directory scope penalized
        // every crate that keeps tests out-of-tree
        scope "crate"
    }
    function-density {
        // count production functions only; inline #[cfg(test)]
        // modules shouldn't consume the per-file budget
        exempt-test-scope true
    }
}
