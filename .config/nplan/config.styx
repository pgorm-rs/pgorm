platforms (
    {
        platform "generative-native"
        files (security/generative/bridge/**/*.rs security/generative/bridge/Cargo.toml security/generative/bridge/Cargo.lock)
        checks {
            unit {
                // The bridge links libpython, so the interpreter has to be the
                // pinned one: a shim whose LIBDIR no longer exists fails at the
                // link step with a message about a missing library rather than
                // about the interpreter.
                cmd "env PYO3_PYTHON=python3.14 cargo test --manifest-path security/generative/bridge/Cargo.toml --locked --target-dir target --lib"
            }
            format {
                cmd "cargo fmt --manifest-path security/generative/bridge/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path security/generative/bridge/Cargo.toml --all"
            }
            clippy {
                cmd "cargo clippy --manifest-path security/generative/bridge/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "generative-compile"
        files (security/generative/compile/**/*.rs security/generative/compile/Cargo.toml security/generative/compile/Cargo.lock)
        checks {
            unit {
                cmd "cargo test --manifest-path security/generative/compile/Cargo.toml --locked --target-dir target"
            }
            format {
                cmd "cargo fmt --manifest-path security/generative/compile/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path security/generative/compile/Cargo.toml --all"
            }
            clippy {
                cmd "cargo clippy --manifest-path security/generative/compile/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "generative-replay"
        files (security/generative/replay/**/*.rs security/generative/replay/Cargo.toml security/generative/replay/Cargo.lock)
        checks {
            unit {
                cmd "cargo test --manifest-path security/generative/replay/Cargo.toml --locked --target-dir target --lib"
            }
            format {
                cmd "cargo fmt --manifest-path security/generative/replay/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path security/generative/replay/Cargo.toml --all"
            }
            clippy {
                cmd "cargo clippy --manifest-path security/generative/replay/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "generative-python"
        files (security/generative/*.py security/generative/src/**/*.py security/generative/tests/**/*.py security/generative/pyproject.toml)
        checks {
            format {
                cmd "uv tool run --from ruff==0.12.12 ruff format --check security/generative"
                fix "uv tool run --from ruff==0.12.12 ruff format security/generative"
            }
            lint {
                cmd "uv tool run --from ruff==0.12.12 ruff check security/generative"
            }
            unit {
                cmd "env PYTHONPATH=security/generative/src python3 -m unittest discover -s security/generative/tests"
            }
        }
    }
    {
        platform "python-distribution"
        files (pgorm-python/Cargo.toml pgorm-python/Cargo.lock Cargo.toml pgorm-*/Cargo.toml pgorm-query/pgorm-query-derive/Cargo.toml pgorm-python/checks/notices.py pgorm-python/licenses/** pgorm-python/python/pgorm/DEPENDENCIES.json pgorm-python/python/pgorm/THIRD_PARTY_NOTICES.txt)
        checks {
            notices {
                cmd "python3 pgorm-python/checks/notices.py"
            }
        }
    }
    {
        platform "python-types"
        files (pgorm-python/python/pgorm/**/*.py pgorm-python/python/pgorm/**/*.pyi)
        checks {
            typing {
                cmd "uv tool run --from mypy==1.18.2 mypy --strict --cache-dir target/python-types-mypy pgorm-python/python/pgorm"
            }
        }
    }
    {
        platform "python-transactions"
        files (pgorm-python/python/pgorm/transactions.py pgorm-python/python/pgorm/runtime.py pgorm-python/python/pgorm/_native.pyi)
        checks {
            typing {
                cmd "uv tool run --from mypy==1.18.2 mypy --strict --cache-dir target/python-transactions-mypy pgorm-python/python/pgorm/transactions.py pgorm-python/python/pgorm/runtime.py"
            }
        }
    }
    {
        platform "python-schema"
        files (pgorm-python/python/pgorm/schema/**/*.py pgorm-python/python/pgorm/_schema.pyi)
        checks {
            typing {
                cmd "uv tool run --from mypy==1.18.2 mypy --strict --cache-dir target/python-schema-mypy pgorm-python/python/pgorm/schema"
            }
        }
    }
    {
        platform "python-pipeline"
        files (pgorm-python/python/pgorm/pipeline/**/*.py pgorm-python/python/pgorm/_pipeline_*.pyi)
        checks {
            typing {
                cmd "uv tool run --from mypy==1.18.2 mypy --strict --cache-dir target/python-pipeline-mypy pgorm-python/python/pgorm/pipeline"
            }
        }
    }
    {
        platform "python-models"
        files (pgorm-python/python/pgorm/**/*.py pgorm-python/python/pgorm/**/*.pyi)
        checks {
            typing {
                cmd "uv tool run --from mypy==1.18.2 mypy --strict --cache-dir target/python-models-mypy pgorm-python/python/pgorm/models"
            }
        }
    }
    {
        platform "python-codegen"
        files (pgorm-python/tests/codegen-entities/** pgorm-python/tests/application-binding/src/account.rs pgorm-python/tests/application-binding/src/note.rs)
        checks {
            format {
                cmd "cargo fmt --manifest-path pgorm-python/tests/codegen-entities/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path pgorm-python/tests/codegen-entities/Cargo.toml --all"
            }
            clippy {
                cmd "cargo clippy --manifest-path pgorm-python/tests/codegen-entities/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "python-application"
        files (pgorm-python/**/*.rs pgorm-python/Cargo.toml pgorm-python/Cargo.lock pgorm-python/tests/application-binding/Cargo.toml pgorm-python/tests/application-binding/Cargo.lock)
        checks {
            format {
                cmd "cargo fmt --manifest-path pgorm-python/tests/application-binding/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path pgorm-python/tests/application-binding/Cargo.toml --all"
            }
            clippy {
                cmd "cargo clippy --manifest-path pgorm-python/tests/application-binding/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "python-native"
        files (pgorm-python/**/*.rs pgorm-python/Cargo.toml pgorm-python/Cargo.lock)
        checks {
            format {
                cmd "cargo fmt --manifest-path pgorm-python/Cargo.toml --all -- --check"
                fix "cargo fmt --manifest-path pgorm-python/Cargo.toml --all"
            }
            check {
                cmd "cargo check --manifest-path pgorm-python/Cargo.toml --locked --target-dir target"
            }
            clippy {
                cmd "cargo clippy --manifest-path pgorm-python/Cargo.toml --locked --target-dir target --all-targets -- -D warnings"
            }
        }
    }
    {
        platform "rust"
        files (src/**/*.rs pgorm-macros/**/*.rs pgorm-codegen/**/*.rs pgorm-migration/**/*.rs pgorm-pool/**/*.rs pgorm-query/**/*.rs pgorm-sql-macro/**/*.rs tests/**/*.rs)
        checks {
            format {
                cmd "cargo fmt --all -- --check"
                fix "cargo fmt --all"
            }
            check {
                cmd "cargo check --workspace"
            }
            // nextest stays out of the commit gate deliberately: it needs a
            // live Postgres and does not fit the check budget. Run it
            // explicitly.
            clippy {
                cmd "cargo clippy --workspace --all-targets -- -D warnings"
            }
        }
    }
)

commit {
    type-prefix "required"
}

// Workflow coverage lives in the sidecar; code keeps its inline annotations.
annotations {
    mode @both
}

quality {
    // scaffold templates are starting shapes for downstream
    // crates, not code any structural gate can judge
    exempt-paths (pgorm-migration/template/**)
    duplication {
        // the entity derives are exercised by declaring a whole
        // throwaway entity per case — model struct, empty Relation,
        // ActiveModelBehavior — so sibling cases in one test module are
        // near-identical by construction. Collapsing them into one
        // parameterised fixture would hide the single attribute each
        // case exists to vary
        exempt-test-scope true
    }
    test-footprint {
        // roll the test:prod ratio up per crate so tests/
        // counts toward src/ — the directory scope penalized
        // every crate that keeps tests out-of-tree
        scope "crate"
    }
    function-name {
        // the temporal accessors are named `as_ref_<variant>` over their own
        // Value variants, and DateTimeWithTimeZone is spelled that way so
        // generated entity source keeps compiling unchanged. Shortening this
        // one would break the run of names its siblings establish
        allow-names (as_ref_date_time_with_time_zone)
    }
    function-density {
        // count production functions only; inline #[cfg(test)]
        // modules shouldn't consume the per-file budget
        exempt-test-scope true
    }
    trivial-function {
        // a newtype's constructor reads as a pass-through because that
        // is all it can be: the field is private, so `new` is the only
        // way to build one. The alternative the gate implies — exposing
        // the field — is worse than the indirection it objects to
        //
        // account_only is the root-only graph shape. It takes the alias
        // slice every other factory takes precisely so a generated call
        // site need not special-case the one arity that joins nothing;
        // the uniformity is the logic the gate cannot see
        //
        // over is one of three sibling entry points into the window-spec
        // builder. by and sort_by each delegate to it and add a call, so
        // only over itself reads as a pass-through — but a caller writing
        // Over::default() where its siblings read over(), by(..) and
        // sort_by(..) is the outcome the trio exists to prevent
        //
        // raw is one of the Expr family's entry points — col, val, value,
        // template, raw. It reads as a pass-through only because its bound
        // was tightened to &'static str, which deleted the conversion that
        // used to sit in the body; the bound IS the contract the function
        // exists to state. The alternative the gate implies — callers
        // writing SimpleExpr::Raw(..) — makes the AST variant the
        // ergonomic spelling and drops the one entry point where the
        // verbatim-SQL decision is documented
        allow-names (new account_only over raw)
    }
}
