                    {
                        id infra.tx.batch
                        title "batch_execute on ConnectionTrait (three impls + metric layer)"
                        kind @feat
                    }

                    {
                        id infra.tx.metric-tx
                        title "begin_instrumented + InstrumentedTransaction rollback metric"
                        kind @feat
                        deps (infra.tx.rollback)
                        log (
                            {
                                at 2026-09-02T00:08:31.330198Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }

                    {
                        id infra.tx.tests
                        title "Integration tests: rollback, savepoints, isolation, batch, pool parallelism"
                        kind @test
                        deps (
                            infra.tx.rollback
                            infra.tx.config
                            infra.tx.batch
                            infra.tx.metric-tx
                            infra.tx.closure
                        )
                    }

                    {
                        id infra.tx.closure
                        title "Closure transaction API (AsyncFnOnce) + serializable-retry helper"
                        kind @feat
                        implements {
                            main ([spec:pgorm:sem:conn.tx.closure] [spec:pgorm:sem:conn.tx.retry])
                        }
                        deps (infra.tx.rollback)
                        log (
                            {
                                at 2026-09-01T21:37:53.590629Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Shape validated by live spike (see infra.tx-review errata): async fn transaction<'s, F, T, E>(conn: &'s mut DatabaseConnection, f: F) -> Result<T, TransactionError<E>> where F: AsyncFnOnce(&mut DatabaseTransaction<'s>) -> Result<T, E> — move the &'s mut borrow into begin (no reborrow) so the closure sees the concrete DatabaseTransaction<'s>. Use explicit rollback() internally on the error path (dep: infra.tx.rollback) instead of relying on Drop, so the rollback is awaited and its error surfaces. Retry helper takes AsyncFnMut + TransactionOptions and retries on SQLSTATE 40001."
                            }
                        )
                    }
                )
            }
        )
    }

