            {
                id orm.try-insert-conflicted
                title "TryInsert conflict reporting: exec_without_returning says Inserted(0), with_returning leaks RecordNotFound"
                kind @fix
                log (
                    {
                        at 2026-09-02T11:33:00.357486Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Found by verify.exec: only TryInsert::exec produces TryInsertResult::Conflicted. exec_without_returning returns Ok(0) from Insert's path so a skipped conflict reports Inserted(0); exec_with_returning propagates RecordNotFound instead of mapping to Conflicted. All three behaviors pinned in tests/returning_tests.rs (try_insert_result_variants). Fix = map the empty/not-found outcomes to Conflicted consistently; exec.crud.try-insert bumps and the pinning test flips from documenting the asymmetry to asserting the fix."
                    }

                    {
                        at 2026-09-02T12:15:34.424217Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
