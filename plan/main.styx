            {
                id sql.empty-select-list
                title "Fail loudly on an empty select list instead of rendering invalid SQL"
                kind @fix
                log (
                    {
                        at 2026-09-02T11:33:17.377368Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Found by verify.query: select_only() (or any statement whose projection list ends up empty) renders `SELECT  FROM \"cake\"` — syntactically invalid, fails only at execution. The rule text is accurate (\"clears the entire select list\") so no spec lie; this is an ergonomics fix. Options: panic at build time with a clear message (matches the builder's existing panic conventions, e.g. the mixing panic), or leave a documented footgun. Pinned in tests/query_build_tests.rs. Touches pgorm-query's builder; query.build.modifiers and possibly sql.render.select-order bump if behavior changes."
                    }

                    {
                        at 2026-09-02T12:01:28.508426Z
                        author "brendan@necessary.nu"
                        kind @decision
                        text "Operator decision, superseding the earlier panic-at-build framing: NO PANIC — per [dec:pgorm:no-panic], an empty select list must surface as a typed error, not a panic. The rendering API (to_string/build) has no Result channel, so the guard belongs at the nearest fallible boundary: the ORM execution/build path returns DbErr::Query before anything is sent (and the QueryTrait::build surface, which is fallible-adjacent, per implementation judgment). pgorm-query's raw to_string stays documented as producing what it produces. Rejected: panic with a clear message (violates the no-panic ban); leave-as-is (invalid SQL failing server-side with an opaque error)."
                    }

                    {
                        at 2026-09-02T12:23:43.854243Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }
        )
    }

