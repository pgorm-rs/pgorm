sites (
    {path .github/workflows/generative-run.yml, spec (
        [spec:pgorm:req:generative.ci]
    )}
    {path .github/workflows/generative.yml, spec (
        [spec:pgorm:req:generative.ci]
    )}
    {path .github/workflows/napi.yml, spec (
        [spec:pgorm:req:napi.runtimes+1]
    )}
    {path .github/workflows/sqlmap-run.yml, spec (
        [spec:pgorm:req:security.sqlmap.ci+2]
        [spec:pgorm:req:security.sqlmap.pin+1]
        [spec:pgorm:req:security.sqlmap.runner-tests]
    )}
    {path .github/workflows/sqlmap.yml, spec (
        [spec:pgorm:req:security.sqlmap.ci+2]
    )}
    {path security/sqlmap/acceptance/2026-09-14.md, spec (
        [spec:pgorm:req:security.sqlmap.acceptance+1]
    )}
    {path security/sqlmap/acceptance/2026-10-31.md, spec (
        [spec:pgorm:def:security.sqlmap/test]
        [spec:pgorm:req:security.sqlmap.acceptance+1/test]
        [spec:pgorm:req:security.sqlmap.adapter/test]
        [spec:pgorm:req:security.sqlmap.fixtures/test]
        [spec:pgorm:req:security.sqlmap.isolation/test]
        [spec:pgorm:req:security.sqlmap.observability/test]
    )}
)
