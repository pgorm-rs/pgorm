{
  "name": "pgorm-napi",
  "version": "0.2.0",
  "private": true,
  "description": "Asynchronous PostgreSQL access through pgorm from Node.js and Deno, over Node-API",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/pgorm-rs/pgorm",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:node": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"tests/*.test.ts\"",
    "test:deno": "deno test --allow-ffi --allow-read --allow-env --allow-run tests/"
  }
}
